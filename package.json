{
  "name": "@meddleware/walrus-ui",
  "version": "0.1.35",
  "homepage": "https://docs.meddleware.co.uk/blockchain/sui/walrus-storage/",
  "description": "Standalone Vue 3 SPA for uploading blobs to Walrus decentralised storage and managing owned blobs — wallet-connected, NFT-gated relay support.",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/walrus-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@meddleware/design-tokens": "^0.1.5",
    "@meddleware/nft-gate-client": "^0.0.9",
    "@meddleware/ui": "^0.1.19",
    "@meddleware/wallet-adapter": "^0.0.7",
    "@meddleware/walrus-client": "^0.0.15",
    "@meddleware/walrus-relay": "^0.1.14",
    "@mysten/sui": "^2.31.0",
    "@mysten/wallet-standard": "^0.21.0",
    "@mysten/walrus": "~1.2.28",
    "@mysten/walrus-wasm": "~0.3.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "~1.63.0",
    "@types/node": "~24.12.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~6.0.0",
    "vite": "^8.3.0",
    "vitest": "~5.0.1",
    "vue-tsc": "~3.3.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
