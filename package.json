{
  "name": "@meddleware/walrus-storage-ui",
  "version": "0.1.62",
  "homepage": "https://docs.meddleware.co.uk/blockchain/sui/walrus-storage/",
  "description": "Standalone Vue 3 SPA for uploading blobs to Walrus decentralised storage and managing owned blobs — wallet-connected, NFT-gated relay support.",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/walrus-storage-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:html": "html-validate \"src/**/*.vue\"",
    "licenses": "node scripts/third-party-licenses.mjs",
    "check:licenses": "node scripts/third-party-licenses.mjs --check"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@meddleware/design-tokens": "^0.1.10",
    "@meddleware/ui": "^0.1.32",
    "@meddleware/walrus-storage-client": "^0.0.31",
    "@meddleware/walrus-storage-kit": "^0.1.34",
    "@mysten/sui": "^2.37.0",
    "@mysten/walrus": "~1.2.36",
    "@mysten/walrus-wasm": "~0.3.1",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "@meddleware/wallet-adapter": ">=0.0.12 <0.2.0"
  },
  "devDependencies": {
    "@meddleware/access-gate-client": "^0.0.10",
    "@meddleware/eslint-config": "^0.0.3",
    "@meddleware/wallet-adapter": "^0.0.17",
    "@playwright/test": "~1.64.1",
    "@types/node": "~26.6.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "html-validate": "^11.17.0",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "postcss": "^8.5.31",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.0",
    "vitest": "~5.0.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
