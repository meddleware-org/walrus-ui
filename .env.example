# @meddleware/walrus-ui — build-time environment
# Copy to .env.local for local dev (never commit .env.local).
# In production these are Docker --build-arg values baked into the static bundle.
# Nothing here is secret — every VITE_* value ships in the public bundle.

# Network the standalone build selects: testnet | mainnet (default testnet). Embedded views follow
# the host's network selector.
# VITE_NETWORK=testnet

# Operator upload relay (gated by the nft-gate gateway). Unset → the public Mysten relay.
# VITE_WALRUS_RELAY_TESTNET=https://sui-walrus-relay-testnet.meddleware.co.uk
# VITE_WALRUS_RELAY_MAINNET=

# Client ceiling on the relay tip, in MIST (default 50000000 = 0.05 SUI).
# VITE_UPLOAD_RELAY_MAX_TIP_MIST=50000000

# Access gate in front of the operator relay (per network: TESTNET / MAINNET).
# VITE_ACCESS_GATE_ID_TESTNET=0x…
# VITE_ACCESS_GATE_SOULBOUND_TESTNET=true
# VITE_ACCESS_GATE_PRICE_MIST_TESTNET=10000000

# Documentation URL — override to link to a custom or staging docs deployment.
# VITE_DOCS_URL=https://docs.meddleware.co.uk/blockchain/sui/walrus-storage/

# Developer docs URL — override to link to a custom or staging dev-docs deployment.
# VITE_DEV_URL=https://dev.meddleware.co.uk/sui/walrus-storage/
